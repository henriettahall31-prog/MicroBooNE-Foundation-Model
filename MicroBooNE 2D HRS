"""
2D Hierarchical Raster Scan for MicroBooNE Wire Plane Data
==========================================================
Adapted from the FM4NPP 3D raster scan for sPHENIX.

Takes 2D hits (wire, time, charge) from a single MicroBooNE wire plane
and serializes them into a 1D sequence for Mamba / SSM input.

Algorithm:
  1. Partition (wire, time) space into N_time × N_wire grid of boxes
     using quantile binning on both axes
  2. Inter-box ordering: sort boxes by (time_center, wire_center)
     time is the primary axis (analogous to radius in sPHENIX)
  3. Intra-box ordering: sort hits within each box by time
  4. Concatenate → 1D sequence

Usage:
  python microboone_raster_scan.py BNB_All_NoWire_00.h5 --plane 2 --event 0
"""

import numpy as np
import h5py
import argparse
from dataclasses import dataclass, field
from typing import Optional


# ─────────────────────────────────────────────────────────────────────
# Binning
# ─────────────────────────────────────────────────────────────────────

def make_quantile_bins(values: np.ndarray, n_bins: int) -> np.ndarray:
    """Quantile-based binning for roughly equal hit counts per bin."""
    percentiles = np.linspace(0, 100, n_bins + 1)
    edges = np.percentile(values, percentiles)
    edges = np.unique(edges)
    edges[0] = 0.0
    edges[-1] = 1.0
    return edges


def normalize(values: np.ndarray) -> tuple:
    """Normalize values to [0, 1]. Returns (normalized, min, max)."""
    vmin, vmax = values.min(), values.max()
    return (values - vmin) / (vmax - vmin), vmin, vmax


# ─────────────────────────────────────────────────────────────────────
# Main serialization class
# ─────────────────────────────────────────────────────────────────────

@dataclass
class MicroBooNERasterScan:
    """2D Hierarchical Raster Scan for MicroBooNE wire plane hits.
    
    Parameters
    ----------
    n_time_bins : int
        Number of bins along the time (drift) axis
    n_wire_bins : int
        Number of bins along the wire axis
    """
    n_time_bins: int = 8
    n_wire_bins: int = 8
    
    # Stored after fitting
    time_edges_: Optional[np.ndarray] = field(default=None, repr=False)
    wire_edges_: Optional[np.ndarray] = field(default=None, repr=False)
    
    def serialize(self, wire: np.ndarray, time: np.ndarray,
                  charge: Optional[np.ndarray] = None,
                  return_details: bool = False):
        """Serialize 2D wire plane hits into a 1D sequence.
        
        Parameters
        ----------
        wire : np.ndarray of shape (N,)
            Wire numbers
        time : np.ndarray of shape (N,)
            Drift time ticks
        charge : np.ndarray of shape (N,), optional
            Integrated charge per hit
        return_details : bool
            If True, return intermediate data for visualization
            
        Returns
        -------
        order : np.ndarray of shape (N,)
            Indices into the original arrays giving the serialized order.
        details : dict (only if return_details=True)
        """
        N = len(wire)
        assert len(time) == N
        
        # Step 1: Normalize to [0, 1]
        time_norm, time_min, time_max = normalize(time)
        wire_norm, wire_min, wire_max = normalize(wire)
        
        # Step 2: Create bins (quantile on normalized values)
        self.time_edges_ = make_quantile_bins(time_norm, self.n_time_bins)
        self.wire_edges_ = make_quantile_bins(wire_norm, self.n_wire_bins)
        
        actual_n_time = len(self.time_edges_) - 1
        actual_n_wire = len(self.wire_edges_) - 1
        
        # Step 3: Assign each hit to a box
        time_bin = np.clip(np.digitize(time_norm, self.time_edges_) - 1, 0, actual_n_time - 1)
        wire_bin = np.clip(np.digitize(wire_norm, self.wire_edges_) - 1, 0, actual_n_wire - 1)
        
        # Composite box ID
        box_id = time_bin * actual_n_wire + wire_bin
        
        # Step 4: Compute box centers for inter-box ordering
        time_centers = 0.5 * (self.time_edges_[:-1] + self.time_edges_[1:])
        wire_centers = 0.5 * (self.wire_edges_[:-1] + self.wire_edges_[1:])
        
        unique_boxes = np.unique(box_id)
        
        box_center_time = np.zeros(len(unique_boxes))
        box_center_wire = np.zeros(len(unique_boxes))
        
        for i, bid in enumerate(unique_boxes):
            ti = bid // actual_n_wire
            wi = bid % actual_n_wire
            ti = min(ti, len(time_centers) - 1)
            wi = min(wi, len(wire_centers) - 1)
            box_center_time[i] = time_centers[ti]
            box_center_wire[i] = wire_centers[wi]
        
        # Step 5: Inter-box ordering — time → wire
        # lexsort: last key is primary, so (wire, time) means sort by time first
        inter_box_order = np.lexsort((box_center_wire, box_center_time))
        sorted_boxes = unique_boxes[inter_box_order]
        
        # Step 6: Intra-box ordering — sort by time within each box
        final_order = []
        box_assignments = []
        
        for rank, bid in enumerate(sorted_boxes):
            mask = box_id == bid
            points_in_box = np.where(mask)[0]
            
            if len(points_in_box) == 0:
                continue
            
            intra_order = np.argsort(time[points_in_box])
            sorted_points = points_in_box[intra_order]
            
            final_order.extend(sorted_points.tolist())
            box_assignments.extend([rank] * len(sorted_points))
        
        final_order = np.array(final_order, dtype=int)
        
        if return_details:
            # Convert normalized edges back to physical units for plotting
            time_edges_physical = self.time_edges_ * (time_max - time_min) + time_min
            wire_edges_physical = self.wire_edges_ * (wire_max - wire_min) + wire_min
            details = {
                'wire': wire,
                'time': time,
                'time_bin': time_bin,
                'wire_bin': wire_bin,
                'box_id': box_id,
                'box_order_rank': np.array(box_assignments),
                'time_edges': time_edges_physical,
                'wire_edges': wire_edges_physical,
                'n_occupied_boxes': len(unique_boxes),
                'n_total_boxes': actual_n_time * actual_n_wire,
            }
            return final_order, details
        
        return final_order


# ─────────────────────────────────────────────────────────────────────
# Visualization
# ─────────────────────────────────────────────────────────────────────

def plot_serialization(wire, time, order, details, plane_id, save_path='microboone_raster_scan.png'):
    """Visualize the 2D raster scan serialization."""
    try:
        import matplotlib
        matplotlib.use('Agg')
        import matplotlib.pyplot as plt
    except ImportError:
        print("matplotlib not available, skipping visualization")
        return
    
    plane_names = {0: 'U (+60°)', 1: 'V (-60°)', 2: 'Y (collection)'}
    plane_name = plane_names.get(plane_id, f'Plane {plane_id}')
    
    fig, axes = plt.subplots(2, 2, figsize=(16, 12))
    fig.suptitle(f'MicroBooNE 2D Raster Scan — {plane_name}', fontsize=16, fontweight='bold')
    
    box_ranks = details['box_order_rank']
    seq_colors = np.arange(len(order))
    
    # --- Panel 1: (wire, time) colored by sequence position ---
    ax = axes[0, 0]
    scatter = ax.scatter(wire[order], time[order], s=2,
                        c=seq_colors, cmap='viridis', alpha=0.6)
    fig.colorbar(scatter, ax=ax, label='Sequence position')
    for edge in details['wire_edges']:
        ax.axvline(edge, color='r', alpha=0.3, lw=0.8, linestyle='--')
    for edge in details['time_edges']:
        ax.axhline(edge, color='r', alpha=0.3, lw=0.8, linestyle='--')
    ax.set_xlabel('Wire number')
    ax.set_ylabel('Time tick')
    ax.set_title('(wire, time) colored by sequence position')
    
    # --- Panel 2: (wire, time) colored by box rank ---
    ax = axes[0, 1]
    scatter = ax.scatter(wire[order], time[order], s=2,
                        c=box_ranks, cmap='tab20', alpha=0.6)
    fig.colorbar(scatter, ax=ax, label='Box rank')
    for edge in details['wire_edges']:
        ax.axvline(edge, color='r', alpha=0.3, lw=0.8, linestyle='--')
    for edge in details['time_edges']:
        ax.axhline(edge, color='r', alpha=0.3, lw=0.8, linestyle='--')
    ax.set_xlabel('Wire number')
    ax.set_ylabel('Time tick')
    ax.set_title(f'(wire, time) colored by box ({details["n_occupied_boxes"]}/{details["n_total_boxes"]} occupied)')
    
    # --- Panel 3: time vs sequence position ---
    ax = axes[1, 0]
    ax.scatter(np.arange(len(order)), time[order], s=2,
              c=box_ranks, cmap='tab20', alpha=0.6)
    ax.set_xlabel('Sequence position')
    ax.set_ylabel('Time tick')
    ax.set_title('Serialized: time vs sequence position')
    box_boundaries = np.where(np.diff(box_ranks) != 0)[0]
    for b in box_boundaries:
        ax.axvline(b, color='k', alpha=0.08, lw=0.5)
    
    # --- Panel 4: wire vs sequence position ---
    ax = axes[1, 1]
    ax.scatter(np.arange(len(order)), wire[order], s=2,
              c=box_ranks, cmap='tab20', alpha=0.6)
    ax.set_xlabel('Sequence position')
    ax.set_ylabel('Wire number')
    ax.set_title('Serialized: wire vs sequence position')
    for b in box_boundaries:
        ax.axvline(b, color='k', alpha=0.08, lw=0.5)
    
    plt.tight_layout()
    plt.savefig(save_path, dpi=150, bbox_inches='tight')
    print(f"Saved visualization to {save_path}")
    plt.close()


# ─────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(description='MicroBooNE 2D Raster Scan Serialization')
    parser.add_argument('data_file', help='Path to MicroBooNE HDF5 file')
    parser.add_argument('--plane', type=int, default=2, help='Wire plane (0=U, 1=V, 2=Y)')
    parser.add_argument('--event', type=int, default=0, help='Which event index to process')
    parser.add_argument('--n-time-bins', type=int, default=8, help='Number of time bins')
    parser.add_argument('--n-wire-bins', type=int, default=8, help='Number of wire bins')
    parser.add_argument('--output', type=str, default='microboone_raster_scan.png', help='Output plot path')
    args = parser.parse_args()
    
    # Load data — only read one event to avoid loading 674M hits
    print(f"Loading data from {args.data_file}")
    f = h5py.File(args.data_file, 'r')
    h = f['hit_table']
    
    total_hits = len(h['local_wire'])
    print(f"Total hits in file: {total_hits}")
    
    # Find target event by scanning event_id in chunks
    print(f"Scanning for event {args.event}...")
    chunk_size = 100000
    current_event = -1
    event_start = None
    event_end = None
    
    for start in range(0, total_hits, chunk_size):
        end = min(start + chunk_size, total_hits)
        chunk_ids = h['event_id'][start:end]
        
        # Find unique events in this chunk
        for i in range(len(chunk_ids)):
            # Check if this row's event_id differs from previous
            if i == 0 and start == 0:
                current_event += 1
            elif i == 0:
                # Compare with last row of previous chunk
                prev_id = h['event_id'][start - 1]
                if not np.array_equal(chunk_ids[i], prev_id):
                    current_event += 1
            else:
                if not np.array_equal(chunk_ids[i], chunk_ids[i - 1]):
                    current_event += 1
            
            if current_event == args.event and event_start is None:
                event_start = start + i
            elif current_event > args.event and event_end is None:
                event_end = start + i
                break
        
        if event_end is not None:
            break
    
    # Handle last event in file
    if event_start is not None and event_end is None:
        event_end = total_hits
    
    if event_start is None:
        print(f"Event {args.event} not found.")
        f.close()
        return
    
    print(f"Event {args.event}: rows {event_start}-{event_end} ({event_end - event_start} hits)")
    
    # Now load only this event's data
    plane = h['local_plane'][event_start:event_end].flatten()
    wire = h['local_wire'][event_start:event_end].flatten()
    time = h['local_time'][event_start:event_end].flatten()
    charge = h['integral'][event_start:event_end].flatten()
    f.close()
    
    # Filter to selected plane
    plane_mask = plane == args.plane
    wire = wire[plane_mask].astype(float)
    time = time[plane_mask].astype(float)
    charge = charge[plane_mask].astype(float)
    
    plane_names = {0: 'U', 1: 'V', 2: 'Y'}
    print(f"Event {event_idx}, Plane {args.plane} ({plane_names.get(args.plane, '?')}): {len(wire)} hits")
    print(f"Wire range: [{wire.min():.0f}, {wire.max():.0f}]")
    print(f"Time range: [{time.min():.1f}, {time.max():.1f}]")
    
    if len(wire) == 0:
        print("No hits found for this event/plane combination.")
        return
    
    # Run 2D Raster Scan
    scanner = MicroBooNERasterScan(
        n_time_bins=args.n_time_bins,
        n_wire_bins=args.n_wire_bins,
    )
    
    order, details = scanner.serialize(wire, time, charge=charge, return_details=True)
    
    # Print summary
    print(f"\n{'='*60}")
    print(f"2D RASTER SCAN RESULTS")
    print(f"{'='*60}")
    print(f"Grid: {args.n_time_bins} × {args.n_wire_bins} "
          f"= {details['n_total_boxes']} total boxes")
    print(f"Occupied boxes: {details['n_occupied_boxes']}")
    print(f"Sequence length: {len(order)}")
    
    # Show first few elements
    print(f"\nFirst 10 hits in serialized order:")
    print(f"  {'idx':>5s}  {'wire':>6s}  {'time':>10s}  {'charge':>10s}")
    for i in range(min(10, len(order))):
        idx = order[i]
        print(f"  {idx:5d}  {wire[idx]:6.0f}  {time[idx]:10.1f}  {charge[idx]:10.2f}")
    
    # Visualize
    plot_serialization(wire, time, order, details, args.plane, save_path=args.output)
    
    # Save serialized output
    out_path = args.output.replace('.png', '_data.npz')
    np.savez(out_path,
             order=order,
             wire_seq=wire[order],
             time_seq=time[order],
             charge_seq=charge[order],
             box_rank=details['box_order_rank'])
    print(f"Saved serialized data to {out_path}")


if __name__ == '__main__':
    main()
